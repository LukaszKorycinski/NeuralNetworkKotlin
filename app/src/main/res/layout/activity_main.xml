        <!--            android:textColor="@color/textColor"-->
        <!--            app:layout_constraintTop_toTopOf="@+id/seekbar3"-->
        <!--            app:layout_constraintEnd_toEndOf="@+id/seekbar3" />-->


        <SeekBar
                android:id="@+id/seekbar4"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/colorAccent"
                android:max="100"
                android:min="0"
                android:progress="20"
                android:progressTint="@color/colorAccent"
                android:thumbTint="@color/colorAccent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seekbar2" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creatures.mutantRatio (less - more)"
                android:textColor="@color/textColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/seekbar4" />

        <TextView
                android:id="@+id/seekbar4TV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/textColor"
                app:layout_constraintEnd_toEndOf="@+id/seekbar4"
                app:layout_constraintTop_toTopOf="@+id/seekbar4" />

        <SeekBar
                android:id="@+id/seekbar5"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/colorAccent"
                android:max="50"
                android:min="-50"
                android:progress="0"
                android:progressTint="@color/colorAccent"
                android:thumbTint="@color/colorAccent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seekbar4" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpeedCost"
                android:textColor="@color/textColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/seekbar5" />

        <TextView
                android:id="@+id/seekbar5TV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/textColor"
                app:layout_constraintEnd_toEndOf="@+id/seekbar5"
                app:layout_constraintTop_toTopOf="@+id/seekbar5" />


        <SeekBar
                android:id="@+id/seekbar6"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/colorAccent"
                android:max="150"
                android:min="0"
                android:progress="1"
                android:progressTint="@color/colorAccent"
                android:thumbTint="@color/colorAccent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seekbar5" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed"
                android:textColor="@color/textColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/seekbar6" />

        <TextView
                android:id="@+id/seekbar6TV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/textColor"
                app:layout_constraintEnd_toEndOf="@+id/seekbar6"
                app:layout_constraintTop_toTopOf="@+id/seekbar6" />

        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GFX"
                android:textColor="@color/textColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seekbar6" />

        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEyes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="switchEyes"
                android:textColor="@color/textColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/switchMode" />

        <TextView
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/colorAccent"
                android:padding="8dp"
                android:text="saveNN"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/switchEyes" />

        <TextView
                android:id="@+id/loadButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@color/colorAccent"
                android:padding="8dp"
                android:text="loadNN"
                app:layout_constraintStart_toEndOf="@+id/saveButton"
                app:layout_constraintTop_toBottomOf="@+id/switchEyes" />

        <ImageView
                android:id="@+id/creatureKey"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:background="@color/colorAccent"
                android:src="@drawable/champ"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loadButton" />

        <TextView
                android:id="@+id/fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS: "
                android:textColor="@color/textColor"
                android:textSize="22dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/creatureKey" />

        <TextView
                android:id="@+id/log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" "
                android:textColor="@color/textColor"
                android:textSize="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fps" />

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>